    "preart:export-v2": "node tools/env/require-node.mjs",
    "test": "node --test tests/*.test.js",
    "pretest": "node tools/env/require-node.mjs",
    "proof:hammerlock": "node tools/debug/hammerlock_authoring_proof.mjs",
    "art:measure-joints": "node tools/wrestler-cutter/measure-joint-articulation.mjs",
