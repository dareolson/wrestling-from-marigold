    "art:build": "node tools/wrestler-cutter/build-character-view.mjs",
    "preart:normalize-profile-v2": "node tools/env/require-node.mjs",
    "art:export-v2": "node tools/wrestler-cutter/export-v2-sheet.mjs",
    "preart:verify-candidate": "node tools/env/require-node.mjs",
