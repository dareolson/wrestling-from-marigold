{
  "name": "wrestling-from-marigold",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "env:check": "node tools/env/require-node.mjs",
    "dev": "vite",
    "build": "vite build",
    "debug:watch": "node tools/debug/watch.mjs",
    "debug:shot": "node tools/debug/shot.mjs",
    "debug:play": "node tools/debug/play.mjs",
    "debug:sim": "node tools/debug/sim.mjs",
    "debug:probe": "node tools/debug/probe.mjs",
    "proof:staging": "node tools/debug/staging_transport_proof.mjs",
    "rig:tuner": "vite --open /tools/rig-tuner/",
    "move:editor": "vite --open /tools/move-editor/",
    "rig:validate": "node tools/rig/validate-character-rigs.mjs",
    "prerig:validate": "node tools/env/require-node.mjs",
    "rig:certify": "node tools/rig/certify.mjs",
    "prerig:certify": "node tools/env/require-node.mjs",
    "art:sheet": "vite --open /tools/wrestler-cutter/canonical-sheet.html",
